{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "service", "registration", "metrics", "bootstrap", "blueprint", "persistence", "scaler", "terminationGracePeriodSeconds"],
  "properties": {
    "replicaCount": { "type": "integer", "const": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "enum": ["ClusterIP", "LoadBalancer", "NodePort"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "registration": {
      "type": "object",
      "required": ["namespace", "port", "authMode", "token", "oidc", "ingress"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "authMode": { "enum": ["token", "oidc"] },
        "token": {
          "type": "object",
          "required": ["existingSecret", "secretKey"],
          "properties": {
            "existingSecret": { "type": "string" },
            "secretKey": { "type": "string", "minLength": 1 }
          }
        },
        "oidc": {
          "type": "object",
          "required": ["provider", "issuerURL", "clientID", "audience", "identityClaim", "subjectTokenType", "scopes", "deviceFlow", "ca", "sshUserCA"],
          "properties": {
            "provider": { "enum": ["external", "bundledDex"] },
            "issuerURL": { "type": "string" },
            "clientID": { "type": "string" },
            "audience": { "type": "string" },
            "identityClaim": { "type": "string", "minLength": 1 },
            "subjectTokenType": { "enum": ["id-token", "access-token"] },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "deviceFlow": { "type": "boolean" },
            "ca": {
              "type": "object",
              "required": ["existingSecret", "secretKey"],
              "properties": {
                "existingSecret": { "type": "string" },
                "secretKey": { "type": "string", "minLength": 1 }
              }
            },
            "sshUserCA": {
              "type": "object",
              "required": ["existingSecret", "secretKey", "certificateTTL", "clockSkew"],
              "properties": {
                "existingSecret": { "type": "string" },
                "secretKey": { "type": "string", "minLength": 1 },
                "certificateTTL": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
                "clockSkew": { "type": "string", "pattern": "^[0-9]+(s|m)$" }
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "required": ["enabled", "className", "annotations", "host", "path", "tls"],
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "host": { "type": "string" },
            "path": { "type": "string", "pattern": "^/" },
            "tls": {
              "type": "object",
              "required": ["enabled", "secretName"],
              "properties": {
                "enabled": { "type": "boolean" },
                "secretName": { "type": "string" }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "authMode": { "const": "oidc" } } },
          "then": {
            "properties": {
              "oidc": {
                "properties": {
                  "clientID": { "minLength": 1 },
                  "audience": { "minLength": 1 },
                  "sshUserCA": {
                    "properties": { "existingSecret": { "minLength": 1 } }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "required": ["enabled", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "bootstrap": {
      "type": "object",
      "required": ["existingSecret", "secretKey", "policy"],
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 2 }
      }
    },
    "blueprint": {
      "type": "object",
      "required": ["enabled", "existingConfigMap", "configMapKey", "document"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingConfigMap": { "type": "string" },
        "configMapKey": { "type": "string", "minLength": 1 },
        "document": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "keep", "size", "accessModes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "keep": { "type": "boolean" },
        "size": { "type": "string", "minLength": 1 },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30 },
    "scaler": {
      "type": "object",
      "required": ["kubernetes", "rbac"],
      "properties": {
        "kubernetes": {
          "type": "object",
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "rbac": {
          "type": "object",
          "required": ["create", "clusterWide", "namespaces"],
          "properties": {
            "create": { "type": "boolean" },
            "clusterWide": { "type": "boolean" },
            "namespaces": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "dex": {
      "type": "object",
      "required": ["enabled", "config"],
      "properties": {
        "enabled": { "type": "boolean" },
        "config": {
          "type": "object",
          "required": ["issuer", "storage", "staticClients", "connectors"],
          "properties": {
            "issuer": { "type": "string" },
            "storage": { "type": "object" },
            "staticClients": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "object" }
            },
            "connectors": { "type": "array" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "registration": {
            "properties": {
              "authMode": { "const": "oidc" },
              "oidc": { "properties": { "provider": { "const": "external" } } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "registration": {
            "properties": {
              "oidc": { "properties": { "issuerURL": { "pattern": "^https://[^/?#]+" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "registration": { "properties": { "authMode": { "const": "token" } } } }
      },
      "then": { "properties": { "dex": { "properties": { "enabled": { "const": false } } } } }
    },
    {
      "if": { "properties": { "dex": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "registration": {
            "properties": {
              "authMode": { "const": "oidc" },
              "oidc": {
                "properties": {
                  "provider": { "const": "bundledDex" },
                  "subjectTokenType": { "const": "id-token" }
                }
              }
            }
          },
          "dex": {
            "properties": {
              "config": { "properties": { "issuer": { "pattern": "^https://[^/?#]+" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registration": {
            "properties": {
              "authMode": { "const": "oidc" },
              "oidc": { "properties": { "provider": { "const": "bundledDex" } } }
            }
          }
        }
      },
      "then": { "properties": { "dex": { "properties": { "enabled": { "const": true } } } } }
    }
  ]
}
